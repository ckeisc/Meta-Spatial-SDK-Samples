<?xml version="1.0" encoding="utf-8"?>
<!-- PlayerView for the hover-to-play capture tiles. surface_type has no
     programmatic setter in Media3 (XML attribute only): texture_view is
     required because a SurfaceView's private window surface does not track
     spatial panel transforms, misaligning the video. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="zoom" />
